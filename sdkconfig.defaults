# Rust often needs a bit of an extra main task stack size compared to C (the default is 3K)
# You might have to increase this further if you allocate large stack variables in the main task
# The Luanti server runs in the main task, and has grown: 16 KB once
# overflowed into the heap after a login.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768

# Increase a bit these stack sizes as they are also a bit too small by default
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096

# You might have to increase this further if you spawn your own Rust threads 
# that allocate large stack variables; or better yet - use 
# `std::thread::Builder::new().stack_size(XXX)` for spawning
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_USE_MALLOC=y

CONFIG_FATFS_LFN_HEAP=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM_SPEED_80M=y

CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# Wi-Fi and lwIP buffers in PSRAM where possible. Moving them to internal
# RAM with ESP-IDF's iperf settings (64 buffers, larger aggregation windows)
# was tried: throughput didn't improve and internal RAM ran out under load.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32

# Per-task CPU time, for the CPU load figures on the status screen
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# Stop at once, naming the task, if any task overflows its stack (rather than
# corrupting the memory next to it and crashing later somewhere else).
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y

# Guard words round every heap block, so an overrun is caught at the block
# it damages (checked by the server's periodic heap check, and on free).
CONFIG_HEAP_POISONING_LIGHT=y

# The USB drive (holding BOOT for 3 s at start-up):
# TinyUSB with mass storage. The buffer holds a whole wear-levelling
# sector, so the PC's writes don't each rewrite a sector.
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=4096
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="esp32-s3-minetest"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="Minetest on a stick"
CONFIG_TINYUSB_DESC_MSC_STRING="Minetest on a stick"

# The public server list (announce.rs) is HTTPS. mbedTLS's buffers (16 KB
# in, 4 KB out) and handshake memory come from malloc rather than internal
# RAM only, so those over SPIRAM_MALLOC_ALWAYSINTERNAL go in PSRAM: internal
# RAM has no block that big to spare while the server runs. The root
# certificate bundle is ESP-IDF's default (CONFIG_MBEDTLS_CERTIFICATE_BUNDLE).
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y
